# Salin file ini menjadi .env lalu isi dengan kredensial database di komputer/server kamu.
# File .env tidak ikut di-commit (lihat .gitignore).
# Variabel yang tidak diisi akan memakai nilai cadangan di includes/config.php.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simpus_mini
DB_USER=postgres
DB_PASS=
# require untuk Supabase, disable untuk PostgreSQL lokal tanpa SSL
DB_SSLMODE=disable
